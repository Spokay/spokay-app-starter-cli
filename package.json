{
  "name": "spokay-app-starter-cli",
  "version": "2.0.1",
  "description": "A CLI for creating Fullstack starter applications from templates with OIDC authentication support",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "spokay-app-starter": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node dist-test/basic-test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "angular",
    "spring-boot",
    "cli",
    "starter",
    "template",
    "generator",
    "oidc",
    "authentication",
    "scaffold",
    "fullstack"
  ],
  "author": "Spokay",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spokay/spokay-app-starter-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Spokay/spokay-app-starter-cli/issues"
  },
  "homepage": "https://github.com/Spokay/spokay-app-starter-cli#readme",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "inquirer": "^14.2.0",
    "ora": "^9.4.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.38.0",
    "globals": "^15.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
