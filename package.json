  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spokay/spokay-app-starter-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Spokay/spokay-app-starter-cli/issues"
  },
  "homepage": "https://github.com/Spokay/spokay-app-starter-cli#readme",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "inquirer": "^14.2.0",
    "ora": "^9.4.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
